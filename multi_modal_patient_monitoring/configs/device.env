# Default inference devices
# Valid values: CPU | GPU | NPU
# NPU requires: /dev/accel device, render group access, and
# compatible NPU drivers (linux-npu-driver >= v1.32.1 for Wildcat Lake)

ECG_DEVICE=GPU
RPPG_DEVICE=GPU
MDPNP_DEVICE=CPU
POSE_3D_DEVICE=GPU

# Bedside device source: openice (MD PnP simulators + DDS bridge) | sdc (IEEE 11073 SDC gateway + bridge)
DEVICE_SOURCE=openice