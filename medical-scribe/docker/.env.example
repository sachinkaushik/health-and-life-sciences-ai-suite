#
# Settings for docker/docker-compose.yaml. `make setup` copies this to docker/.env and fills in
# PAYLOAD_SECRET, the render/video group ids and the NPU device. docker/.env is not committed.

# Images
REGISTRY=
TAG=latest

# App login/session secret; keep it with data/ui/db.sqlite (a new one locks the old database).
PAYLOAD_SECRET=

# UI: medical-scribe (clinician app) or studio (Edge AI Demo Studio shell).
APP_MODE=medical-scribe

# Host ports (host networking). Service ports must be in the app's instance range, 8100-8199.
UI_PORT=8080
STT_PORT=8190
DIARIZATION_PORT=8191
LLM_PORT=8192
SCRIBE_DB_PORT=8193

# Speech to text (OEP audio-analyzer); the model is exported to OpenVINO on first start.
STT_MODEL=openai/whisper-large-v3-turbo
STT_DEVICE=GPU
STT_PRECISION=int8

# Diarization: cpu or xpu:0
DIARIZATION_DEVICE=cpu

# Required: diarization checks it on every start (gated pyannote model; accept its terms on huggingface.co).
HF_TOKEN=

# Host folders shared with the native ./start.sh run (paths relative to docker/).
MODELS_DIR=../models
DATA_DIR=../data
LOGS_DIR=../logs

# Device access; filled in by `make setup`.
RENDER_GID=
VIDEO_GID=
NPU_DEVICE=/dev/null
