<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.0.0">
  <diagram id="hld-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Medical Scribe: High-Level Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Docker Compose (make up) · host network · every service on 127.0.0.1&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="50" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="&lt;b&gt;Clinician browser&lt;/b&gt;&lt;br&gt;Medical Scribe UI (React)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Today · Consultations · System&lt;br&gt;mic capture · speaker alignment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="operator" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;make setup · build · up · status · logs · down&lt;br&gt;docker/.env (HF_TOKEN, APP_MODE, ports)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="125" y="560" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="edge-device" value="Edge device · Intel Core Ultra (Arrow Lake) · Docker" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="980" height="760" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="&lt;b&gt;ui&lt;/b&gt; :8080&lt;br&gt;&lt;i&gt;medical-scribe-ui&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Next.js 16 + Payload CMS (SQLite)&lt;br&gt;API proxy · health poller&lt;br&gt;deployment.json · APP_MODE&lt;br&gt;EXTERNAL_SERVICES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="edge-device">
          <mxGeometry x="30" y="240" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="stt" value="&lt;b&gt;speech-to-text&lt;/b&gt; :8190&lt;br&gt;&lt;i&gt;medical-scribe-stt&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;oep wrapper + OEP audio-analyzer (2026.2.1)&lt;br&gt;Whisper large-v3-turbo · int8 · OpenVINO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="edge-device">
          <mxGeometry x="360" y="50" width="270" height="95" as="geometry" />
        </mxCell>

        <mxCell id="dia" value="&lt;b&gt;diarization&lt;/b&gt; :8191&lt;br&gt;&lt;i&gt;medical-scribe-workers&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pyannote speaker-diarization-community-1&lt;br&gt;doctor voice embeddings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="edge-device">
