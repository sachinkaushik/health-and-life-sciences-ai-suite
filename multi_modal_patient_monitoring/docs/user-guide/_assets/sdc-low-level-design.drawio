<mxfile host="app.diagrams.net" type="device">
  <diagram id="lld-components" name="1 - Component LLD">
    <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MMPM SDC device source - low-level design (component view)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="-50" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== AI workloads ===================== -->
        <mxCell id="cW" value="AI workloads (existing services)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="340" height="470" as="geometry" />
        </mxCell>
        <mxCell id="wR" value="&lt;b&gt;rppg&lt;/b&gt; (rPPG service)&lt;br&gt;sample.mp4, 30 fps, looped → face ROI 36×36, batch 10&lt;br&gt;MTTS-CAN (OpenVINO, RPPG_DEVICE)&lt;br&gt;band-pass + FFT → HR / RR + 30 Hz waves&lt;br&gt;gRPC StreamVitals → AGGREGATOR_PORT (50061 in SDC mode)&lt;br&gt;control :8084 /start /stop /status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wE" value="&lt;b&gt;ai-ecg&lt;/b&gt; backend :8000&lt;br&gt;GET /predict_stream_next → next .mat record (300 Hz)&lt;br&gt;HuBERT-ECG (OpenVINO) → embedding, inference_ms&lt;br&gt;signal_classifier.py → rhythm label&lt;br&gt;JSON: signal, result, file, inference_ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wP" value="&lt;b&gt;3d-pose-estimation&lt;/b&gt;&lt;br&gt;walking video, about 20 fps, looped&lt;br&gt;human-pose-estimation-3d-0001 (POSE_3D_DEVICE)&lt;br&gt;19 joints 2D / 3D, detect_activity()&lt;br&gt;gRPC PublishPose → aggregator :50051&lt;br&gt;MJPEG :8085/video_feed (camera of multimodal beds)&lt;br&gt;control :8083 /start /stop /status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="300" height="140" as="geometry" />
        </mxCell>

        <!-- ===================== sdc-gateway ===================== -->
        <mxCell id="cG" value="sdc-gateway (SDC provider, sdc11073) - services/sdc-gateway/sdc_gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="620" height="830" as="geometry" />
        </mxCell>
        <mxCell id="gMain" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;env → DeviceConfig (facility MMPM, poc ICU, 200 ms chunks, video URLs, max 16)&lt;br&gt;WSDiscovery(bind_ip).start()&lt;br&gt;add bed-01 (multimodal, ai, primary, fixed EPR) + SDC_EXTRA_DEVICES&lt;br&gt;start RppgIngest, AiEcgPoller, uvicorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gApi" value="&lt;b&gt;api.py&lt;/b&gt; - FastAPI 127.0.0.1:8093&lt;br&gt;GET /devices&lt;br&gt;POST /devices {type: monitor or multimodal}&lt;br&gt;DELETE /devices/{bed_id} (409 for the primary bed)&lt;br&gt;GET /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gMgr" value="&lt;b&gt;devices.py · DeviceManager&lt;/b&gt;&lt;br&gt;add(kind): next bed-NN, stable EPR (uuid5), serial MMPM-NNNN, round-robin video URL&lt;br&gt;→ build_mdib(vmds_for(kind, ai)) → MdibWriter → SdcProvider.start_all() → set video URL → set_location(MMPM/ICU/bed-NN) → DeviceSimulator.start()&lt;br&gt;remove(bed_id): sim.stop() → provider.stop_all() (sends WS-Discovery Bye, ends subscriptions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="205" width="580" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gBed" value="Bed (one per bed-NN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=3;fontSize=11;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="315" width="580" height="345" as="geometry" />
        </mxCell>
        <mxCell id="gModel" value="&lt;b&gt;mdib_model.py&lt;/b&gt;&lt;br&gt;vmds_for(): DEVICE_VMD always&lt;br&gt;+ VIDEO_VMD (multimodal)&lt;br&gt;+ RPPG_VMD, AI_ECG_VMD (AI bed only)&lt;br&gt;build_mdib(): MDS → VMD → Channel → Metric descriptors, codes, units, SamplePeriod; states ON / VALID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="345" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gMdib" value="&lt;b&gt;ProviderMdib&lt;/b&gt; (sdc11073)&lt;br&gt;descriptors (fixed layout)&lt;br&gt;metric states (live values)&lt;br&gt;each transaction → report to subscribers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="345" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gSim" value="&lt;b&gt;simulator.py · DeviceSimulator&lt;/b&gt;&lt;br&gt;_numeric_loop (1 s): _Vital = baseline + drift·sin(t) + jitter, clamped → HR, RR, SpO2, Temp, EtCO2, Sys, Dia, MAP&lt;br&gt;_wave_loop (200 ms): beat / breath phase →&lt;br&gt;_ecg: PQRST Gaussians (250 Hz)&lt;br&gt;_arterial: pleth (100 Hz), ABP (120 Hz)&lt;br&gt;_capnogram: CO2 (20 Hz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="485" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gWriter" value="&lt;b&gt;writer.py · MdibWriter&lt;/b&gt;&lt;br&gt;set_metrics() → metric_state_transaction&lt;br&gt;push_samples() → rt_sample_state_transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="485" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gProv" value="&lt;b&gt;SdcProvider&lt;/b&gt; (sdc11073, DPWS)&lt;br&gt;GetMdib, Subscribe&lt;br&gt;EpisodicMetricReport (numerics, strings)&lt;br&gt;WaveformStream (waves)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="570" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gRppg" value="&lt;b&gt;rppg_ingest.py · RppgIngest&lt;/b&gt;&lt;br&gt;gRPC VitalService :50061 (StreamVitals / PublishVital)&lt;br&gt;_RPPG_MAP: HEART_RATE → numeric.rppg_hr + wave.rppg, RESP_RATE → numeric.rppg_rr + wave.rppg_resp, *_AVG → numerics&lt;br&gt;→ bed-01 MdibWriter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="675" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="gEcg" value="&lt;b&gt;ai_ecg_poller.py · AiEcgPoller&lt;/b&gt;&lt;br&gt;GET AI_ECG_URL every 1 s&lt;br&gt;push_samples(wave.ai_rhythm_strip, 300 Hz)&lt;br&gt;set_metrics(string.ai_rhythm, string.ai_rhythm_source, numeric.ai_rhythm_latency), same timestamp&lt;br&gt;→ bed-01 MdibWriter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="675" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="gWsd" value="&lt;b&gt;WSDiscovery&lt;/b&gt; (UDP 3702 multicast)&lt;br&gt;Hello on provider start_all · Bye on stop_all · answers Probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="800" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== SDC network ===================== -->
        <mxCell id="nNet" value="&lt;b&gt;IEEE 11073 SDC&lt;/b&gt;&lt;br&gt;(host network)&lt;br&gt;&lt;br&gt;&lt;b&gt;WS-Discovery&lt;/b&gt;&lt;br&gt;Hello / Bye / Probe&lt;br&gt;&lt;br&gt;&lt;b&gt;DPWS (SOAP over HTTP)&lt;/b&gt;&lt;br&gt;GetMdib&lt;br&gt;Subscribe&lt;br&gt;&lt;br&gt;&lt;b&gt;Reports&lt;/b&gt;&lt;br&gt;EpisodicMetricReport&lt;br&gt;WaveformStream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;align=center;verticalAlign=middle;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1045" y="50" width="170" height="830" as="geometry" />
        </mxCell>

        <!-- ===================== sdc-bridge ===================== -->
        <mxCell id="cB" value="sdc-bridge (SDC consumer) - services/sdc-bridge/sdc_bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="50" width="560" height="830" as="geometry" />
        </mxCell>
        <mxCell id="bMain" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;AggregatorStream(GRPC_HOST:50051)&lt;br&gt;SdcFleet(facility MMPM, primary EPR, rppg-001, 1 s wave window)&lt;br&gt;uvicorn :8092" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="90" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bApi" value="&lt;b&gt;api.py&lt;/b&gt; - FastAPI :8092&lt;br&gt;POST /start, /stop → set_enabled()&lt;br&gt;GET /beds, /status, /health&lt;br&gt;GET /predict_stream_next → AI-ECG snapshot (503 if none yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1530" y="90" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bFleet" value="&lt;b&gt;sdc_client.py · SdcFleet&lt;/b&gt; (thread _run)&lt;br&gt;_on_hello / _on_bye → queue + _wake (instant add / drop)&lt;br&gt;_run: _prune_disconnected → _drop(byes) → _consider(hellos), else _scan() every 5 s&lt;br&gt;_scan: search_services(timeout 3 s) → _consider → _prune_missing&lt;br&gt;_consider: facility filter (MMPM), bed id from the provider location&lt;br&gt;_open: SdcConsumer.start_all → ConsumerMdib.init_mdib (GetMdib + Subscribe) → Translator.bind → observableproperties.bind(on_metrics, on_waves)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="205" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="bSess" value="_Session (one per subscribed bed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=3;fontSize=11;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="1260" y="365" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="bCons" value="&lt;b&gt;SdcConsumer + ConsumerMdib&lt;/b&gt; (sdc11073)&lt;br&gt;receives reports, updates the local MDIB copy, fires observable callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1280" y="395" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="bMap" value="&lt;b&gt;mapping.py · CODE_MAP&lt;/b&gt;&lt;br&gt;(coding system, code) → Target(group, metric, device_type)&lt;br&gt;groups: DEVICE, RPPG, AI_ECG, VIDEO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1530" y="395" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="bTr" value="&lt;b&gt;translator.py · Translator&lt;/b&gt;&lt;br&gt;bind(): handle → Target, fs = 1 / SamplePeriod, camera URL&lt;br&gt;on_metrics(): DEVICE → Vital (only when enabled) · RPPG averages → Vital · AI_ECG label / source / latency · VIDEO URL&lt;br&gt;on_waves(): DEVICE → _buffer_device_wave (re-chunk to about 1 s) → Vital · RPPG wave → Vital(rppg-001) · AI_ECG strip&lt;br&gt;_pair_ai_ecg(): strip + label with the same timestamp → _ai_snapshot&lt;br&gt;_send(): Vital(device_id bed-NN-ecg / -spo2 / ..., metadata bed_id, primary, device_type)&lt;br&gt;rPPG and AI-ECG are mapped on the primary bed only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1280" y="505" width="480" height="175" as="geometry" />
        </mxCell>
        <mxCell id="bFwd" value="&lt;b&gt;forwarder.py · AggregatorStream&lt;/b&gt;&lt;br&gt;queue (max 2000, drops when full) → one long-lived gRPC StreamVitals → aggregator :50051, reconnects every 2 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="710" width="520" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Aggregator ===================== -->
        <mxCell id="cA" value="patient-monitoring-aggregator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1830" y="50" width="420" height="570" as="geometry" />
        </mxCell>
        <mxCell id="aApi" value="&lt;b&gt;server.py · FastAPI :8001&lt;/b&gt;&lt;br&gt;POST /start?target=... → sdc-bridge /start, rPPG :8084, pose :8083, starts ai_ecg_polling_loop&lt;br&gt;POST /stop (same targets)&lt;br&gt;GET /beds → sdc-bridge :8092/beds&lt;br&gt;GET / POST / DELETE /devices → sdc-gateway :8093/devices&lt;br&gt;GET /events (SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="90" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="aVit" value="&lt;b&gt;VitalService.StreamVitals&lt;/b&gt; (gRPC :50051)&lt;br&gt;_detect_workload_type(device_id): rppg-* → rppg, otherwise mdpnp&lt;br&gt;VitalConsumer.consume() → {workload_type, event_type, timestamp, bed_id, primary, payload}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="255" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="aPose" value="&lt;b&gt;PoseServicer.PublishPose&lt;/b&gt; (gRPC :50051)&lt;br&gt;→ 3d-pose / pose3d event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="380" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="aEcg" value="&lt;b&gt;ai_ecg_polling_loop&lt;/b&gt; (1 s) · AIECGClient.poll_next()&lt;br&gt;AI_ECG_URL = sdc-bridge :8092/predict_stream_next (SDC mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="450" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aSse" value="&lt;b&gt;ws_broadcaster.py · SSEManager&lt;/b&gt;&lt;br&gt;broadcast() → one asyncio queue per SSE client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="535" width="380" height="65" as="geometry" />
        </mxCell>

        <!-- ===================== UI ===================== -->
        <mxCell id="cU" value="ui (React, :3000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="1830" y="640" width="420" height="340" as="geometry" />
        </mxCell>
        <mxCell id="uSse" value="&lt;b&gt;sseMiddleware.ts&lt;/b&gt; · EventSource /events&lt;br&gt;mdpnp + bed_id → bedsSlice.bedVital (per-bed numerics and strips)&lt;br&gt;rppg / ai-ecg / 3d-pose → servicesSlice (workload cards)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="680" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uCs" value="&lt;b&gt;CentralStation.tsx / BedTile.tsx&lt;/b&gt;&lt;br&gt;poll GET /beds every 3 s (1 s while an add / remove is pending) → setBeds&lt;br&gt;BedTile: numerics, ECG / pleth / CO2 strips, camera from video_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="775" width="380" height="85" as="geometry" />
        </mxCell>
        <mxCell id="uDp" value="&lt;b&gt;DevicesPanel.tsx / WorkloadCard.tsx&lt;/b&gt;&lt;br&gt;Add monitor / multimodal, Remove → api.addDevice / removeDevice (disabled until Start)&lt;br&gt;Start / Stop → POST /start, /stop&lt;br&gt;WorkloadCard: rPPG, AI-ECG strip, 3D pose, MJPEG :8085" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1850" y="875" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== Legend and steps ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;━━ data (values, waves, SDC reports, Vital)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#EA580C&quot;&gt;- - - control (REST: start / stop / add / remove)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;- - - discovery (Hello / Bye / Probe, GetMdib + Subscribe)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E22CE&quot;&gt;- - - video (MJPEG)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="steps" value="&lt;b&gt;Main flows (circled numbers on the arrows)&lt;/b&gt;&lt;br&gt;① Startup: gateway adds bed-01 (+ extras); each SdcProvider sends Hello&lt;br&gt;② Bridge _on_hello → _open: GetMdib + Subscribe for each bed&lt;br&gt;③ Simulator → MdibWriter → ProviderMdib → reports every 1 s / 200 ms&lt;br&gt;④ Translator maps codes → Vital → AggregatorStream → gRPC :50051&lt;br&gt;⑤ Aggregator → SSE /events → UI bed tiles&lt;br&gt;⑥ rPPG → gateway :50061 → bed-01 vmd.rppg → SDC → bridge → Vital(rppg-001)&lt;br&gt;⑦ Gateway polls AI-ECG → bed-01 vmd.aiecg → SDC → bridge snapshot → aggregator polls :8092/predict_stream_next&lt;br&gt;⑧ Add / remove: UI → aggregator → gateway :8093 → Hello / Bye → bridge subscribes / drops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1">
