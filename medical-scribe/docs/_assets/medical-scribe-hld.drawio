  <diagram id="hld-flow" name="Consultation flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
        <mxCell id="f1" parent="f0" />

        <mxCell id="f-title" value="&lt;b&gt;Medical Scribe: consultation flow (upload or live)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="f1">
          <mxGeometry x="40" y="10" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="f-enrol" value="&lt;b&gt;0. Doctor enrolment&lt;/b&gt; (once)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;record ≥ 3 s voice sample&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="f1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-audio" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;upload a recording&lt;br&gt;or live microphone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="f1">
          <mxGeometry x="40" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="f-stt" value="&lt;b&gt;1. Speech to text&lt;/b&gt; :8190&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /v1/audio/transcriptions (verbose_json, word timestamps)&lt;br&gt;live: WS /v1/realtime&lt;br&gt;→ text · words · detected language&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1">
          <mxGeometry x="330" y="200" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-dia" value="&lt;b&gt;2. Diarization&lt;/b&gt; :8191&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /v1/diarize (doctor reference_embedding)&lt;br&gt;poll GET /v1/diarize/{job_id}&lt;br&gt;→ speaker segments: Doctor / Patient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1">
          <mxGeometry x="330" y="380" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-align" value="&lt;b&gt;3. Align in browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;words → speaker segments (overlap)&lt;br&gt;sentence majority vote&lt;br&gt;→ speaker-labelled transcript&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="f1">
          <mxGeometry x="680" y="290" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-save1" value="&lt;b&gt;4. Save transcript&lt;/b&gt; :8193&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PATCH /v1/sessions/{id}&lt;br&gt;transcripts · status=completed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1">
          <mxGeometry x="1000" y="160" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f-llm" value="&lt;b&gt;5. SOAP note&lt;/b&gt; :8192&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ui /api/services/text-generation/chat&lt;br&gt;→ multiserve /v1/chat/completions (OVMS)&lt;br&gt;streamed · reasoning off · English&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1">
          <mxGeometry x="1000" y="430" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-save2" value="&lt;b&gt;6. Save SOAP note&lt;/b&gt; :8193&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PATCH /v1/sessions/{id}&lt;br&gt;soapReport · reportCreatedAt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1">
          <mxGeometry x="1000" y="620" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f-review" value="&lt;b&gt;Clinician review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;edit · copy · export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1">
          <mxGeometry x="680" y="630" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-emb" value="&lt;b&gt;POST /v1/embedding&lt;/b&gt; :8191&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ stored with PATCH /v1/doctor-profiles/{id}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="f1">
          <mxGeometry x="330" y="75" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fe-enrol" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="f1" source="f-enrol" target="f-emb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-emb-dia" value="doctor embedding" style="endArrow=block;html=1;rounded=1;dashed=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="f1" source="f-emb" target="f-dia">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="115" />
              <mxPoint x="620" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fe-a-stt" value="audio" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-audio" target="f-stt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-a-dia" value="same audio" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-audio" target="f-dia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-stt-align" value="words" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-stt" target="f-align">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-dia-align" value="segments" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-dia" target="f-align">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-align-save" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-align" target="f-save1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-align-llm" value="Generate note" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="f1" source="f-align" target="f-llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-llm-save" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="f1" source="f-llm" target="f-save2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe-save-review" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="f1" source="f-save2" target="f-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-note" value="All calls go through the ui proxy /api/&amp;lt;service&amp;gt;@&amp;lt;instance&amp;gt;/*, except the live WebSockets, which go straight to :8190 / :8191." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="f1">
          <mxGeometry x="40" y="720" width="600" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="hld-original" name="Original app">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="o0" />
