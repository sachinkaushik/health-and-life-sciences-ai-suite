        </mxCell>
        <mxCell id="S2" value="B. Add a bed (buttons are enabled after Start)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;opacity=85;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-10" y="220" width="1660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="C. Bedside vitals (every bed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;opacity=85;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-10" y="615" width="1660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="D. AI data (bed-01 only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;opacity=85;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-10" y="835" width="1660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="E. Remove a bed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;opacity=85;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-10" y="1120" width="1660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="S6" value="&lt;b&gt;Fallback:&lt;/b&gt; if a Hello or Bye is missed, SdcFleet._scan() probes every 5 s; _prune_missing() and _prune_disconnected() remove beds that are gone." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;opacity=90;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-10" y="1395" width="1660" height="36" as="geometry" />
        </mxCell>
        <mxCell id="nSim" value="DeviceSimulator: numerics every 1 s, waves every 200 ms → MdibWriter transactions" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="650" width="215" height="44" as="geometry" />
        </mxCell>

        <!-- A. Start -->
        <mxCell id="m1" value="1. POST /start?target=all" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="135" as="sourcePoint" /><mxPoint x="340" y="135" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. POST :8092/start → enabled.set()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="165" as="sourcePoint" /><mxPoint x="1060" y="165" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. POST :8084/start (rPPG), :8083/start (pose); start ai_ecg_polling_loop" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="195" as="sourcePoint" /><mxPoint x="1540" y="195" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- B. Add a bed -->
        <mxCell id="m4" value="4. POST /devices {type}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="270" as="sourcePoint" /><mxPoint x="340" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. POST :8093/devices" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="298" as="sourcePoint" /><mxPoint x="580" y="298" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. build_mdib, start_all, set_location, DeviceSimulator.start" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="326" as="sourcePoint" /><mxPoint x="820" y="326" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. WS-Discovery Hello (multicast)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#15803D;dashed=1;dashPattern=8 4;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="354" as="sourcePoint" /><mxPoint x="1060" y="354" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="201 {bed_id}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="382" as="sourcePoint" /><mxPoint x="340" y="382" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="201 → placeholder tile, poll every 1 s" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="408" as="sourcePoint" /><mxPoint x="100" y="408" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="8. _on_hello → _consider → _open: GetMdib + Subscribe" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#15803D;dashed=1;dashPattern=8 4;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="440" as="sourcePoint" /><mxPoint x="820" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="MDIB + subscription" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="468" as="sourcePoint" /><mxPoint x="1060" y="468" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m12" value="9. Translator.bind(mdib), observableproperties.bind" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#16A34A;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="498" as="sourcePoint" /><mxPoint x="1300" y="498" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m13" value="10. GET /beds" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="530" as="sourcePoint" /><mxPoint x="340" y="530" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m14" value="GET :8092/beds" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="556" as="sourcePoint" /><mxPoint x="1060" y="556" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m15" value="bed-NN listed → tile shown" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="584" as="sourcePoint" /><mxPoint x="100" y="584" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- C. Bedside vitals -->
        <mxCell id="m16" value="11. EpisodicMetricReport (1 s) → on_metrics()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="720" as="sourcePoint" /><mxPoint x="1300" y="720" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m17" value="12. WaveformStream (200 ms) → on_waves() → buffer to about 1 s" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="750" as="sourcePoint" /><mxPoint x="1300" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m18" value="13. gRPC StreamVitals: Vital(bed-NN-*, bed_id, primary), only when enabled" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="780" as="sourcePoint" /><mxPoint x="340" y="780" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m19" value="14. SSE /events (mdpnp + bed_id) → BedTile" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="810" as="sourcePoint" /><mxPoint x="100" y="810" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- D. AI data -->
        <mxCell id="m20" value="15. rPPG: gRPC Vital → :50061 RppgIngest → vmd.rppg" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="880" as="sourcePoint" /><mxPoint x="820" y="880" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m21" value="16. AiEcgPoller: GET :8000/predict_stream_next (1 s)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;dashed=1;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="908" as="sourcePoint" /><mxPoint x="1540" y="908" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m22" value="strip + label + inference_ms → vmd.aiecg" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="936" as="sourcePoint" /><mxPoint x="820" y="936" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m23" value="17. SDC reports for vmd.rppg and vmd.aiecg" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="966" as="sourcePoint" /><mxPoint x="1300" y="966" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m24" value="18. rPPG Vital (rppg-001) over StreamVitals" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="996" as="sourcePoint" /><mxPoint x="340" y="996" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m25" value="19. ai_ecg_polling_loop: GET :8092/predict_stream_next" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;dashed=1;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1026" as="sourcePoint" /><mxPoint x="1060" y="1026" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m26" value="AI-ECG snapshot (strip paired with label)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="1054" as="sourcePoint" /><mxPoint x="340" y="1054" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m27" value="20. SSE rppg / ai-ecg events → workload cards" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#1D4ED8;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1084" as="sourcePoint" /><mxPoint x="100" y="1084" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- E. Remove a bed -->
        <mxCell id="m28" value="21. DELETE /devices/bed-NN" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1170" as="sourcePoint" /><mxPoint x="340" y="1170" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m29" value="22. DELETE :8093/devices/bed-NN (409 for bed-01)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1198" as="sourcePoint" /><mxPoint x="580" y="1198" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m30" value="23. sim.stop(), provider.stop_all()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1226" as="sourcePoint" /><mxPoint x="820" y="1226" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m31" value="24. WS-Discovery Bye" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#15803D;dashed=1;dashPattern=8 4;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1254" as="sourcePoint" /><mxPoint x="1060" y="1254" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m32" value="25. _drop → unbind callbacks, unsubscribe" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#16A34A;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="1282" as="sourcePoint" /><mxPoint x="1300" y="1282" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m33" value="26. GET /beds" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1312" as="sourcePoint" /><mxPoint x="340" y="1312" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m34" value="GET :8092/beds" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;strokeColor=#EA580C;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1338" as="sourcePoint" /><mxPoint x="1060" y="1338" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m35" value="bed-NN gone → tile removed" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#6B7280;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="1366" as="sourcePoint" /><mxPoint x="100" y="1366" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
