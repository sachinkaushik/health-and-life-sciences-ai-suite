#
# Settings for docker-compose.yaml. `make setup` copies this to .env (git-ignored) and fills in the
# device group ids and the NPU device.

# Images: ${REGISTRY}hl-ai-medical-scribe-<service>:${TAG}
REGISTRY=intel/
TAG=latest

# Where the UI is published. 127.0.0.1 = this machine only: the app has no login, so put a
# TLS reverse proxy with authentication in front before opening it to the network.
BIND_ADDRESS=127.0.0.1
UI_PORT=8080

# Required: diarization loads the gated pyannote model with it on every start (accept the model's
# terms on huggingface.co first).
HF_TOKEN=

# Speech to text (OEP audio-analyzer); exported to OpenVINO on first start.
STT_MODEL=openai/whisper-large-v3-turbo
STT_DEVICE=GPU
STT_PRECISION=int8

# Diarization: cpu or xpu:0 (Intel GPU)
DIARIZATION_DEVICE=cpu

# SOAP note LLM: a Hugging Face OpenVINO repository, pulled on first start. GPU, NPU, CPU or AUTO.
LLM_MODEL=OpenVINO/Qwen3.5-4B-int4-ov
LLM_DEVICE=GPU
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.1
LLM_MAX_TOKENS=2048

# performance-tools metrics-collector image tag (intel/retail-benchmark)
METRICS_TAG=2026.3.0-rc2

# Host folders
MODELS_DIR=./models
DATA_DIR=./data
LOGS_DIR=./logs
METRICS_DIR=./metrics

# Device access; filled in by `make setup`.
RENDER_GID=
VIDEO_GID=
NPU_DEVICE=/dev/null
